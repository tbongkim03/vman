<?xml version="1.0" encoding="utf-8"?>
<!--
  vman 셸 확장용 스파스(sparse) 패키지 매니페스트.

  실제 파일은 패키지 안에 넣지 않고 %LOCALAPPDATA%\vman\bin 을 그대로 가리킨다
  (windows.externalLocation). vman-tray.exe 가 68MB 라 패키지에 복사하면 설치본이
  두 벌이 되고, vman 을 다시 빌드할 때마다 패키지도 다시 만들어야 하기 때문이다.

  {{...}} 자리는 build-msix.ps1 이 채운다. 외부 경로에 사용자 이름이 들어가므로
  매니페스트는 기계마다 새로 만들어야 한다.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop5 com rescap">

  <!-- Publisher 는 서명 인증서의 Subject 와 글자 하나까지 같아야 한다. -->
  <Identity Name="VMan.ShellExt"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>vman</DisplayName>
    <PublisherDisplayName>vman</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- 패키지 밖의 파일을 쓰겠다는 선언. 이게 없으면 externalLocation 이 거부된다. -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- IExplorerCommand 기반 상단 컨텍스트 메뉴는 윈도우 11(빌드 22000) 부터다. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <!--
      이 앱은 실행되지 않는다. 셸 확장을 매달기 위한 껍데기다.
      AppListEntry="none" 으로 시작 메뉴에도 나오지 않게 한다.
    -->
    <Application Id="VMan"
                 Executable="vman-tray.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="vman"
        Description="Python / Java / Node 버전 관리자"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- 셸 확장 DLL 을 COM 서버로 등록한다. 탐색기가 대리자에 로드한다. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="vman shell extension">
              <com:Class Id="FEE6FAFD-826C-4B04-B553-B3DB7616DB8B"
                         Path="VMan.ShellExt.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- 폴더 아이콘 우클릭과 폴더 안 빈 공간 우클릭 양쪽에 건다. -->
        <desktop5:Extension Category="windows.fileExplorerContextMenus">
          <desktop5:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="VManVenv" Clsid="FEE6FAFD-826C-4B04-B553-B3DB7616DB8B" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="VManVenvBackground" Clsid="FEE6FAFD-826C-4B04-B553-B3DB7616DB8B" />
            </desktop5:ItemType>
          </desktop5:FileExplorerContextMenus>
        </desktop5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Extensions>
    <!-- 패키지 내용이 실제로 사는 곳. vman 이 설치된 bin 폴더를 그대로 쓴다. -->
    <uap10:Extension Category="windows.externalLocation">
      <uap10:ExternalLocation Path="{{EXTERNAL_LOCATION}}" />
    </uap10:Extension>
  </Extensions>
</Package>
