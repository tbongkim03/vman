<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>vman</AssemblyName>
    <RootNamespace>VMan.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- RuntimeIdentifier / SelfContained / PublishSingleFile 은 build.ps1 · build.sh 가 넘긴다.
         csproj 에 win-x64 를 박아두면 리눅스 빌드가 막힌다. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMan.Core\VMan.Core.csproj" />
  </ItemGroup>

</Project>
